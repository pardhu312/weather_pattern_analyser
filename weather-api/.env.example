# Database Connection (Render PostgreSQL will set DATABASE_URL automatically)
DATABASE_URL=postgresql://weather_user:password@localhost:5432/weather_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weather_db
DB_USERNAME=postgres
DB_PASSWORD=password

# OpenWeather API Key (from https://openweathermap.org/)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Initial Admin User Credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@weather.local
ADMIN_PASSWORD=YourOwnStrongPassword123!

# JWT Secret (Base64 encoded string, minimum 32 bytes)
# Generate via: openssl rand -base64 32
JWT_SECRET=nu33bwXYTaeIPeuAN9aW1jN1pomUA0pg97Iv4FnW/Cs=

# CORS Allowed Origins (comma-separated or * for wildcard)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Port (Render sets this dynamically)
PORT=8080
