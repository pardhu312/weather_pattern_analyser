# Database Connection (Render PostgreSQL will set DATABASE_URL automatically)
# Or configure individual parameters:
DATABASE_URL=postgresql://weather_user:password@localhost:5432/weather_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weather_db
DB_USERNAME=postgres
DB_PASSWORD=password

# Allowed CORS Origins (comma-separated or * for all)
CORS_ALLOWED_ORIGINS=*

# Port (Render sets this dynamically)
PORT=8001
